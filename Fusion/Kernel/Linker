OUTPUT_FORMAT("elf64-x86-64", "elf64-x86-64", "elf64-x86-64")
OUTPUT_ARCH(i386:x86-64)
ENTRY(_start)

PHDRS
{
  text PT_LOAD FILEHDR PHDRS;
  data PT_LOAD;
  bss PT_LOAD;
}

SECTIONS
{
  . = 0x500;
  
  .text : ALIGN(0x1000) { 
    *(.text .text.*)
  } :text
  
  .rodata : ALIGN(0x1000) {
    *(.rodata .rodata.*)
  } :text
  
  .data : ALIGN(0x1000) { 
    *(.data .data.*)
  } :data
  
  .bss : ALIGN(0x1000) { 
    *(.bss .bss.*)
    *(COMMON)
  } :bss
  
  /DISCARD/ : { 
    *(.eh_frame)
    *(.comment)
    *(.note.GNU-stack)
  }
}