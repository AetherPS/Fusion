OUTPUT_FORMAT("elf64-x86-64", "elf64-x86-64", "elf64-x86-64")
OUTPUT_ARCH(i386:x86-64)
ENTRY(_start)

PHDRS
{
	code_seg PT_LOAD;
	rdata_seg PT_LOAD;
	data_seg PT_LOAD;
	bss_seg PT_LOAD;
}

SECTIONS
{
	. = 0x926200000;
	
	.text : ALIGN(0x1000) {
		*(.text.start)
		*(.text .text.*)
	} : code_seg
	
	.rodata : ALIGN(0x1000) {
		*(.rodata .rodata.*)
	} : rdata_seg
	
	.data : ALIGN(0x1000) { 
		*(.data .data.*)
	} : data_seg
	
	.bss : ALIGN(0x1000) { 
		*(.bss .bss.*)
		*(COMMON)
	} : bss_seg
	
	/DISCARD/ : {
		*(.comment)
		*(.note.GNU-stack)
		*(.eh_frame)
	}
}